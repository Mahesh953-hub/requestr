{
  "manifest_version": 3,
  "name": "requestr Browser Bridge",
  "version": "1.0.0",
  "description": "Relays page-context fetch/XHR activity (and raw HTTP requests seen by chrome.webRequest) to the requestr Android app's Local API server, complementing what the CDP Browser Bridge (Settings -> Browser Bridge) can see.",
  "permissions": [
    "webRequest",
    "storage",
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["page-interceptor.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "requestr Browser Bridge"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
